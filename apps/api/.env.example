# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
# JWTs verified via asymmetric ES256 (JWKS) — no shared secret needed.
# In Supabase: Auth → JWT keys → use asymmetric keys (ECC / ES256).
# Only for custom auth domains; defaults to {SUPABASE_URL}/auth/v1
SUPABASE_JWT_ISSUER=
# Service role — used ONLY by the Telegram webhook (leave empty if no bot)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — model TBD per PRD; verify current model + pricing
OPENAI_API_KEY=sk-...
# OpenAI-compatible gateway base URL (e.g. OpenCode). Leave empty for api.openai.com.
# NOTE: the research agent's web_search tool only works on real OpenAI.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
# $ per 1M tokens for cost tracking in llm_calls (0 = skip cost computation)
OPENAI_INPUT_COST_PER_1M=0
OPENAI_OUTPUT_COST_PER_1M=0

# Telegram bot (optional): create via @BotFather, then register the webhook:
# curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<API_URL>/telegram/webhook&secret_token=<WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

MONTHLY_ANALYSIS_QUOTA=30
CORS_ORIGINS=http://localhost:3000
